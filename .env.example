# Configuration reference only; Bloblin does not automatically load this file.
# Export values in your shell or configure your service manager's environment.
BLOBLIN_LISTEN_ADDR=:8080
BLOBLIN_DATA_DIR=./data
BLOBLIN_LOG_LEVEL=INFO
BLOBLIN_HTTP_READ_HEADER_TIMEOUT=5s
# Zero disables whole-request / response deadlines for future large transfers.
BLOBLIN_HTTP_READ_TIMEOUT=0s
BLOBLIN_HTTP_WRITE_TIMEOUT=0s
BLOBLIN_HTTP_IDLE_TIMEOUT=60s
BLOBLIN_SHUTDOWN_TIMEOUT=30s
